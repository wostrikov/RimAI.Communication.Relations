<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!-- Dependencies: RimWorld ThoughtDef loader, DefInjected ThoughtDef labels/descriptions. -->
  <!-- Responsibility: define the custom RPG dialogue memories used by RimChat TryGainMemory. -->

  <!-- Tier 1: surface affects -->

  <ThoughtDef>
    <defName>RimChat_BriefJoy</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>0.25</durationDays>
    <stackLimit>10</stackLimit>
    <stackedEffectMultiplier>0.85</stackedEffectMultiplier>
    <developmentalStageFilter>Baby, Child, Adult</developmentalStageFilter>
    <stages>
      <li>
        <label>moment of joy</label>
        <description>That brief moment of joy lifted my spirits.</description>
        <baseMoodEffect>2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>RimChat_BriefSadness</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>0.33</durationDays>
    <stackLimit>10</stackLimit>
    <stackedEffectMultiplier>0.85</stackedEffectMultiplier>
    <developmentalStageFilter>Baby, Child, Adult</developmentalStageFilter>
    <stages>
      <li>
        <label>brief sadness</label>
        <description>That fleeting sadness still lingers slightly.</description>
        <baseMoodEffect>-2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>RimChat_SurpriseReaction</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>0.25</durationDays>
    <stackLimit>10</stackLimit>
    <stackedEffectMultiplier>0.85</stackedEffectMultiplier>
    <developmentalStageFilter>Baby, Child, Adult</developmentalStageFilter>
    <stages>
      <li>
        <label>surprised</label>
        <description>The unexpected exchange caught me off guard.</description>
        <baseMoodEffect>1</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>RimChat_DisgustReaction</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>1</durationDays>
    <stackLimit>10</stackLimit>
    <stackedEffectMultiplier>0.85</stackedEffectMultiplier>
    <developmentalStageFilter>Baby, Child, Adult</developmentalStageFilter>
    <stages>
      <li>
        <label>disgusted</label>
        <description>That remark left me feeling disgusted.</description>
        <baseMoodEffect>-3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- Tier 2: emotional echoes -->

  <ThoughtDef>
    <defName>RimChat_Encouraged</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>0.5</durationDays>
    <stackLimit>10</stackLimit>
    <stackedEffectMultiplier>0.85</stackedEffectMultiplier>
    <developmentalStageFilter>Baby, Child, Adult</developmentalStageFilter>
    <stages>
      <li>
        <label>encouraged</label>
        <description>Their words of encouragement boosted my spirits.</description>
        <baseMoodEffect>3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>RimChat_Comforted</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>0.5</durationDays>
    <stackLimit>10</stackLimit>
    <stackedEffectMultiplier>0.85</stackedEffectMultiplier>
    <developmentalStageFilter>Baby, Child, Adult</developmentalStageFilter>
    <stages>
      <li>
        <label>comforted</label>
        <description>Being comforted brought me some peace.</description>
        <baseMoodEffect>3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>RimChat_Mocked</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>0.75</durationDays>
    <stackLimit>10</stackLimit>
    <stackedEffectMultiplier>0.85</stackedEffectMultiplier>
    <developmentalStageFilter>Baby, Child, Adult</developmentalStageFilter>
    <stages>
      <li>
        <label>mocked</label>
        <description>They mocked me and it stings.</description>
        <baseMoodEffect>-3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>RimChat_Teased</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>0.5</durationDays>
    <stackLimit>10</stackLimit>
    <stackedEffectMultiplier>0.85</stackedEffectMultiplier>
    <developmentalStageFilter>Baby, Child, Adult</developmentalStageFilter>
    <stages>
      <li>
        <label>teased</label>
        <description>Being teased left me feeling embarrassed.</description>
        <baseMoodEffect>-2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>RimChat_Praised</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>0.5</durationDays>
    <stackLimit>10</stackLimit>
    <stackedEffectMultiplier>0.85</stackedEffectMultiplier>
    <developmentalStageFilter>Baby, Child, Adult</developmentalStageFilter>
    <stages>
      <li>
        <label>praised</label>
        <description>Their praise made me feel appreciated.</description>
        <baseMoodEffect>3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>RimChat_FeelingInsulted</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>1</durationDays>
    <stackLimit>10</stackLimit>
    <stackedEffectMultiplier>0.85</stackedEffectMultiplier>
    <developmentalStageFilter>Baby, Child, Adult</developmentalStageFilter>
    <stages>
      <li>
        <label>feeling insulted</label>
        <description>I was deeply insulted by those words.</description>
        <baseMoodEffect>-4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>RimChat_FeelingIgnored</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>1</durationDays>
    <stackLimit>10</stackLimit>
    <stackedEffectMultiplier>0.85</stackedEffectMultiplier>
    <developmentalStageFilter>Baby, Child, Adult</developmentalStageFilter>
    <stages>
      <li>
        <label>feeling ignored</label>
        <description>Being ignored stings more than words can say.</description>
        <baseMoodEffect>-3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

</Defs>
